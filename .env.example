# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is gitignored.

# Supabase — https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_DB_PASSWORD=<your-db-password>

# AssemblyAI — https://www.assemblyai.com/dashboard
# SERVER-SIDE ONLY. Never prefix secret keys with NEXT_PUBLIC_
ASSEMBLYAI_API_KEY=<your-assemblyai-key>

# hCaptcha — https://dashboard.hcaptcha.com/sites
# NEXT_PUBLIC_ is safe here — this is the publishable site key, not the secret
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=<your-hcaptcha-site-key>
# The secret key goes in Supabase Dashboard → Auth → Bot & Abuse Protection (NOT in .env)

# Razorpay (scaffolded — inactive in MVP)
# SERVER-SIDE ONLY
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
